{
  "schema": "takesome.tool.v1",
  "id": "northstar.ymap_packer",
  "version": "0.1.0",
  "name": "North Star YMAP Packer",
  "description": "Authoring-side YMAP tool: compiles readable .ymap.xml/.ymap.json map definitions into binary NEF8 .ymap assets, validates headers/hashes, inspects metadata and dumps bodies back to readable source.",
  "kind": "rust-cli",
  "root": ".",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-ymap-packer.exe",
  "default_args": ["compile", "--root", "$repo_root", "--all"],
  "validation_args": ["validate", "--root", "$repo_root", "--all"],
  "formats": [".ymap", ".ymap.xml", ".ymap.json"],
  "content_kinds": ["map_data", "map_definition", "placement_graph"],
  "format_provider": {
    "provider_id": "northstar.ymap_packer",
    "type_ids": ["asset.type.ymap.map_data"],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "tree",
    "editor_schema": "northstar.schema.ymap.map_definition.v1"
  },
  "capabilities": [
    "asset.format.ymap.read",
    "asset.format.ymap.write",
    "asset.format.ymap.inspect",
    "asset.format.ymap.validate",
    "asset.format.ymap.diff",
    "asset.preview.tree",
    "asset.editor.map.edit_schema",
    "assets.maps.ymap_pack",
    "assets.maps.ymap_dump",
    "assets.maps.ymap_inspect",
    "validation.nef8_hash"
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
