{
  "schema": "takesome.tool.v1",
  "id": "northstar.ydd_packer",
  "version": "0.2.0",
  "name": "North Star YDD Packer",
  "description": "Builds and edits YDD V5 drawable dictionaries with built-in MaterialResource payloads or external .ymat@entry bindings.",
  "kind": "rust-cli",
  "root": ".",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-ydd-packer.exe",
  "default_args": [
    "--help"
  ],
  "validation_args": [
    "--help"
  ],
  "formats": [
    ".ydd"
  ],
  "content_kinds": [
    "drawable_dictionary"
  ],
  "format_provider": {
    "provider_id": "northstar.ydd_packer",
    "type_ids": [
      "asset.type.ydd.drawable_dictionary"
    ],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "model",
    "editor_schema": "northstar.schema.ydd.drawable_dictionary.v1"
  },
  "capabilities": [
    "asset.format.ydd.read",
    "asset.format.ydd.write",
    "asset.format.ydd.inspect",
    "asset.format.ydd.validate",
    "asset.format.ydd.diff",
    "asset.preview.model",
    "asset.editor.model.edit_schema",
    "assets.listfile.nef8",
    "assets.drawable_dictionary.ydd",
    "model.import.obj",
    "model.import.gltf",
    "model.import.glb",
    "model.import.fbx.placeholder",
    "validation.nef8_hash",
    "assets.material.builtin",
    "assets.material.external.ymat",
    "assets.material.extract",
    "assets.material.embed"
  ],
  "commands": [
    {
      "id": "help",
      "args": [
        "--help"
      ],
      "description": "Print tool usage."
    },
    {
      "id": "version",
      "args": [
        "version"
      ],
      "description": "Print tool version."
    },
    {
      "id": "accepted-inputs",
      "args": [
        "accepted-inputs"
      ],
      "description": "Print accepted input and output file contract."
    },
    {
      "id": "extract-material",
      "args": [
        "extract-material"
      ],
      "description": "Extract a built-in YDD material into a YMAT dictionary."
    },
    {
      "id": "externalize-material",
      "args": [
        "externalize-material"
      ],
      "description": "Write a built-in material to YMAT and replace it with an external .ymat@entry binding."
    },
    {
      "id": "embed-material",
      "args": [
        "embed-material"
      ],
      "description": "Embed a selected YMAT material into YDD V5 as a built-in MaterialResource payload."
    },
    {
      "id": "set-material-ref",
      "args": [
        "set-material-ref"
      ],
      "description": "Replace a mesh material binding with an external .ymat@entry reference."
    }
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
