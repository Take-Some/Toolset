{
  "schema": "takesome.tool.v1",
  "id": "northstar.nemat_packer",
  "version": "0.1.1",
  "name": "North Star NEMAT Legacy Tool",
  "description": "Legacy NEMAT read/inspect/migration compatibility tool. New authored material assets must use YMAT or YDD/YDR built-in MaterialResource payloads.",
  "kind": "rust-cli",
  "root": ".",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-nemat-packer.exe",
  "default_args": [
    "--help"
  ],
  "validation_args": [
    "--help"
  ],
  "formats": [
    ".nemat",
    ".nemat.xml"
  ],
  "content_kinds": [
    "material_library",
    "material_graph"
  ],
  "format_provider": {
    "provider_id": "northstar.nemat_packer",
    "type_ids": [
      "asset.type.nemat.material_library"
    ],
    "can_read": true,
    "can_write": false,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": false,
    "preview_surface": "material",
    "editor_schema": "northstar.schema.nemat.material_library.v1"
  },
  "capabilities": [
    "asset.format.nemat.read",
    "asset.format.nemat.inspect",
    "asset.format.nemat.validate",
    "assets.materials.nemat_xml_dump",
    "assets.materials.nemat_inspect",
    "validation.nef8_hash",
    "asset.format.nemat.read_compat",
    "assets.materials.migrate_nemat_to_ymat"
  ],
  "build_validation": true,
  "safe_for_build": false,
  "maturity": "legacy-read-compat",
  "commands": []
}
