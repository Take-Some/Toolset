{
  "schema": "takesome.tool.v1",
  "id": "northstar.nepak_manager",
  "version": "0.2.0",
  "name": "North Star NEPAK Manager",
  "description": "Builds, extracts, inspects, verifies, diffs and mount-tests clean .nepak VFS packages as explicit package assets.",
  "kind": "rust-cli",
  "root": ".",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-nepak-manager.exe",
  "default_args": ["--help"],
  "validation_args": ["--help"],
  "formats": [".nepak"],
  "content_kinds": ["vfs_package"],
  "format_provider": {
    "provider_id": "northstar.nepak_manager",
    "type_ids": ["asset.type.nepak.vfs_package"],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "tree",
    "editor_schema": "northstar.schema.nepak.package.clean.v1"
  },
  "capabilities": [
    "assets.container.nepak",
    "assets.container.nepak.writer",
    "assets.container.nepak.inspect",
    "assets.container.nepak.verify",
    "assets.container.nepak.diff",
    "assets.container.nepak.mount_test",
    "asset.preview.tree",
    "asset.editor.package.edit_schema"
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
